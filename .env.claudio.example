# Claudio agent container config — copy to .env.claudio-planner and
# .env.claudio-executor and fill in. Values override the seeded config.yaml
# ONLY where the seed leaves them unset; the image's config.yaml wins for
# server.auth_token (default: dev-token-change-me) — set CLAMS_CLAUDIO_*_TOKEN
# in Clams' .env to match.

# --- LLM (OpenAI-compatible endpoint) ----------------------------------------
CLAUDIO__LLM__BASE_URL=http://host.docker.internal:8731/v1
CLAUDIO__LLM__API_KEY=
CLAUDIO__LLM__MODEL=local-model

# --- agent behaviour -----------------------------------------------------------
# off | on_request | always — the executor instance MUST run with off.
CLAUDIO__AGENT__APPROVAL_MODE=off

# Workspaces the agent may bind (Clams passes worktree paths under /work).
# The executor container mounts the shared worktrees volume at /work.
# CLAUDIO__AGENT__WORKSPACE_ALLOWED_ROOTS=["/work","/sessions"]

# --- github ------------------------------------------------------------------
# Classic PAT with `repo` scope (doc/github.md §1). `gh` picks these up
# automatically. Leave empty if the agent never touches GitHub from its shell.
GITHUB_TOKEN=
GH_TOKEN=

# git commit identity — git reads these directly, no `git config` needed.
GIT_AUTHOR_NAME=Claudio Agent
GIT_AUTHOR_EMAIL=claudio@users.noreply.github.com
GIT_COMMITTER_NAME=Claudio Agent
GIT_COMMITTER_EMAIL=claudio@users.noreply.github.com

# Credentials for raw `git push` from inside this container. Clams pushes task
# branches from the executor-runner (config/clams-gitconfig), so this only
# matters if the agent pushes or fetches private repos itself. `$$` is compose
# escaping: the container receives a literal `$`, expanded by the shell helper
# at push time.
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=credential.https://github.com.helper
GIT_CONFIG_VALUE_0=!f() { [ "$$1" = get ] || exit 0; echo username=x-access-token; echo "password=$$GITHUB_TOKEN"; }; f
