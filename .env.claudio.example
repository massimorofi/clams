# Claudio agent container config — copy to .env.claudio-planner and
# .env.claudio-executor and fill in. Values override the seeded config.yaml
# ONLY where the seed leaves them unset; the image's config.yaml wins for
# server.auth_token (default: dev-token-change-me) — set CLAMS_CLAUDIO_*_TOKEN
# in Clams' .env to match.

# --- LLM (OpenAI-compatible endpoint) ----------------------------------------
CLAUDIO__LLM__BASE_URL=http://host.docker.internal:8731/v1
CLAUDIO__LLM__API_KEY=
CLAUDIO__LLM__MODEL=local-model

# --- agent behaviour -----------------------------------------------------------
# off | on_request | always — the executor instance MUST run with off.
CLAUDIO__AGENT__APPROVAL_MODE=off

# Workspaces the agent may bind (Clams passes worktree paths under /work).
# The executor container mounts the shared worktrees volume at /work.
# CLAUDIO__AGENT__WORKSPACE_ALLOWED_ROOTS=["/work","/sessions"]
