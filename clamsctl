#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"
P=clams; DC=(docker compose -p "$P" -f docker-compose.yml)

die(){ echo "[-] $*" >&2; exit 1; }
need(){ docker info >/dev/null 2>&1 || die "Docker daemon not running"
        docker compose version >/dev/null 2>&1 || die "docker compose v2 required"
        [[ -f .env ]] || die ".env missing (cp .env.example .env)"; }
confirm(){ [[ "${YES:-}" == 1 ]] && return; read -rp "$1 [y/N] " a; [[ $a == y ]] || exit 1; }

case "${1:-}" in
  start)   need; "${DC[@]}" up -d --wait && echo "[+] UI: http://localhost:1075" ;;
  stop)    need; "${DC[@]}" stop ;;
  restart) need; "${DC[@]}" restart ${2:-} ;;
  rebuild) need; "${DC[@]}" pull --ignore-buildable || true
           "${DC[@]}" build --pull
           "${DC[@]}" up -d --wait --force-recreate ;;
  status)  need
           ps_json=$("${DC[@]}" ps --format json 2>/dev/null || true)
           python3 -c '
import sys, json, re
rows = [json.loads(l) for l in sys.argv[1].splitlines() if l.strip()]
tty = sys.stdout.isatty()
G, R, Y, Z = ("\033[32m","\033[31m","\033[33m","\033[0m") if tty else ("","","","")
def short(s):
    m = re.match(r"(\d+)\s+(second|minute|hour|day)", s or "")
    return f"{m[1]}{m[2][0]}" if m else (s or "")
out, ok = [], 0
for c in sorted(rows, key=lambda c: c.get("Service","")):
    h = (c.get("Health") or "").lower(); st = (c.get("State") or "").lower()
    if h == "healthy" or (not h and st == "running"):
        ok += 1; icon, col = "✔", G
    elif h == "starting" or st in ("created","restarting"):
        icon, col = "…", Y
    else:
        icon, col = "✘", R
    label = "Healthy" if h == "healthy" else ("Up" if not h and st == "running" else (h or st or "?").capitalize())
    out.append((icon, col, c.get("Name","?"), label, short(c.get("RunningFor",""))))
print(f"[+] clams status {ok}/{len(rows)} healthy")
w = max((len(n) for _,_,n,_,_ in out), default=0)
for icon, col, name, label, a in out:
    print(f" {col}{icon}{Z} Container {name:<{w}}  {col}{label}{Z}  {a}")
' "$ps_json"
           "${DC[@]}" exec -T planner clams status || true ;;
  logs)    need; "${DC[@]}" logs -f --tail=200 ${2:-} ;;
  migrate) need; "${DC[@]}" run --rm planner clams migrate ;;
  backup)  need; mkdir -p backups
           "${DC[@]}" exec -T planner sqlite3 /data/clams.db ".backup /data/backup.db"
           "${DC[@]}" cp planner:/data/backup.db "backups/clams-$(date +%Y%m%d-%H%M%S).db" ;;
  pause|resume) need; "${DC[@]}" exec -T planner clams command "$1" --by operator ;;
  monitor) need
           echo "== containers =="; "${DC[@]}" ps
           for s in planner executor-runner api redis claudio-planner claudio-executor; do
             echo "== logs $s (last 15m, errors/warnings) =="
             "${DC[@]}" logs --since 15m "$s" 2>&1 \
               | grep -E "ERROR|WARNING|Traceback| 500" | tail -n 20 || true
           done
           echo "== DLQ sample =="
           "${DC[@]}" exec -T redis redis-cli XRANGE clams:dlq - + COUNT 5 || true
           echo "== planner report =="
           "${DC[@]}" exec -T planner clams monitor ;;
  down)    need; confirm "Remove containers (volumes kept)?"; "${DC[@]}" down ;;
  nuke)    need; confirm "DELETE ALL DATA incl. DB and queues?"; "${DC[@]}" down -v ;;
  *) echo "Usage: clamsctl {start|stop|restart [svc]|rebuild|status|logs [svc]|migrate|backup|pause|resume|monitor|down|nuke}"; exit 1 ;;
esac
