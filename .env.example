# Clams v2 — copy to .env and fill in.
# Every key below equals a Settings field default (CI-enforced parity:
# tests/unit/test_env_parity.py).

# --- paths -----------------------------------------------------------------
CLAMS_DATA_DIR=./data
CLAMS_DB_PATH=./data/clams.db
CLAMS_WORK_ROOT=./work
CLAMS_CONFIG_FILE=./config/clams.yaml
# --- bus / redis -----------------------------------------------------------
CLAMS_REDIS_URL=redis://127.0.0.1:6379/0
CLAMS_STREAM_TASKS=clams:tasks
CLAMS_STREAM_EVENTS=clams:events
CLAMS_STREAM_DLQ=clams:dlq
CLAMS_GROUP_EXECUTORS=executors
CLAMS_GROUP_PLANNER=planner
CLAMS_MSG_MAX_BYTES=16384
CLAMS_DLQ_MAX_DELIVERIES=5
# --- claudio agents --------------------------------------------------------
CLAMS_CLAUDIO_PLANNER_URL=http://127.0.0.1:1072
CLAMS_CLAUDIO_PLANNER_TOKEN=
CLAMS_CLAUDIO_EXECUTOR_URL=http://127.0.0.1:1073
CLAMS_CLAUDIO_EXECUTOR_TOKEN=
CLAMS_CLAUDIO_WORKSPACE_ROOT=./work
CLAMS_WORKTREE_UID=1000
CLAMS_WORKTREE_GID=1000
# --- github ----------------------------------------------------------------
CLAMS_GITHUB_TOKEN=
CLAMS_GITHUB_API_BASE=https://api.github.com
CLAMS_GITHUB_GRAPHQL_BASE=https://api.github.com/graphql
# --- api -------------------------------------------------------------------
CLAMS_API_HOST=127.0.0.1
CLAMS_API_PORT=8200
CLAMS_API_TOKEN=
CLAMS_SPA_DIR=./frontend/dist
# --- executor --------------------------------------------------------------
CLAMS_EXECUTOR_ID=executor-1
CLAMS_EXECUTOR_CAPACITY=1
CLAMS_HEARTBEAT_INTERVAL_S=60
CLAMS_EXECUTOR_ALIVE_INTERVAL_S=30
CLAMS_KEEP_FAILED_WORKTREE_HOURS=24
# merge a finished workflow's work onto the project base branch and push it.
# Set false to keep Clams read-only with respect to the base branch.
CLAMS_MERGE_TO_BASE_ON_DONE=True
# after a successful merge, delete the workflow's fully-merged task branches
# from origin. Unmerged branches are never touched.
CLAMS_CLEANUP_MERGED_BRANCHES=True
# --- planner loop ----------------------------------------------------------
CLAMS_PLANNER_CYCLE_S=5.0
CLAMS_INTAKE_EVERY_N_CYCLES=12
CLAMS_PLANNER_HEARTBEAT_MAX_AGE_S=60
CLAMS_EVENTS_BATCH=100
CLAMS_EVENTS_BLOCK_MS=1000
CLAMS_STALL_ALERT_MINUTES=15
CLAMS_STALL_ESCALATE_MINUTES=60
# --- limits (bounded everything) -------------------------------------------
CLAMS_MAX_ATTEMPTS=3
CLAMS_MAX_TURNS=40
CLAMS_MAX_REPLANS=3
CLAMS_MAX_PLAN_TASKS=7
CLAMS_PLANNING_LLM_BUDGET_PER_CYCLE=3
CLAMS_LEASE_DISPATCH_S=600
CLAMS_LEASE_RUNNING_EXTEND_S=600
CLAMS_QUESTION_EXPIRY_H=24
CLAMS_OUTBOX_MAX_ATTEMPTS=5
CLAMS_OUTBOX_BACKOFF_BASE_S=2
CLAMS_RETENTION_EVENTS_DAYS=14
CLAMS_RETENTION_PROCESSED_DAYS=7
CLAMS_RETENTION_SENT_OUTBOX_DAYS=14
# --- watchdog --------------------------------------------------------------
CLAMS_WATCHDOG_PROBE_INTERVAL_S=30
CLAMS_WATCHDOG_HEALTHY_PROBES_TO_RESUME=3
CLAMS_OLDEST_READY_ALERT_S=300
CLAMS_MIN_FREE_DISK_MB=500
CLAMS_MODEL_SERVER_URL=http://192.168.1.172:8731/v1
CLAMS_MAX_DB_SIZE_MB=500
CLAMS_EVIDENCE_TAIL_LIMIT=200
CLAMS_ORPHAN_SILENCE_S=180
# --- misc ------------------------------------------------------------------
CLAMS_ROLE=planner
