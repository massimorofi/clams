# Clams orchestrator — copy to .env and fill in.
# Every value can also be set directly as an environment variable.

# --- GitHub ------------------------------------------------------------------
CLAMS__GITHUB__OWNER=massimorofi
CLAMS__GITHUB__REPO=claudio
CLAMS__GITHUB__TOKEN=
CLAMS__GITHUB__API_BASE=https://api.github.com

# --- GitHub Projects (V2) board sync ----------------------------------------
# Requires a token with 'read:project' and 'update:project' scopes IN ADDITION to
# 'repo'. A plain repo-scoped token cannot read or write project cards: every
# projectsV2 query fails with INSUFFICIENT_SCOPES.
#
# When enabled, Clams resolves the project, its status field and every status
# option ONCE at startup. A missing project, a renamed status field or a missing
# column therefore stops startup with an actionable error instead of failing
# per-item mid-run.
CLAMS__PROJECT__ENABLED=false
# Owner of the board; defaults to CLAMS__GITHUB__OWNER when empty.
CLAMS__PROJECT__OWNER=
# The project's number (from its URL: /orgs/<owner>/projects/<number>)
CLAMS__PROJECT__NUMBER=0
# Name of the single-select column Clams drives.
CLAMS__PROJECT__STATUS_FIELD=Status
# Optional overrides of the built-in label -> column mapping, comma separated.
# Built-in: status:Ready=Todo, status:In Progress=In Progress,
#           status:Review=In Review, status:Blocked=Blocked, status:Done=Done
CLAMS__PROJECT__STATUS_MAP=

# --- Redis event bus ---------------------------------------------------------
CLAMS__REDIS__URL=redis://127.0.0.1:6379/0
CLAMS__REDIS__NAMESPACE=clams

# --- Planner Claudio instance (Web UI + chat) --------------------------------
CLAMS__PLANNER__BASE_URL=http://127.0.0.1:8100
CLAMS__PLANNER__AUTH_TOKEN=
CLAMS__PLANNER__REQUEST_TIMEOUT=120
CLAMS__PLANNER__HOST=0.0.0.0
# The Claudio web image listens on 8080 (not 8000).
CLAMS__PLANNER__PORT=8080

# --- Executor Claudio instance (headless) ------------------------------------
CLAMS__EXECUTOR__BASE_URL=http://127.0.0.1:8101
CLAMS__EXECUTOR__AUTH_TOKEN=
CLAMS__EXECUTOR__REQUEST_TIMEOUT=120
CLAMS__EXECUTOR__EXECUTOR_ID=executor-1
CLAMS__EXECUTOR__LEASE_SECONDS=900

# --- strixper inference manager ---------------------------------------------
CLAMS__STRIXPER__BASE_URL=http://host.docker.internal:8000
CLAMS__STRIXPER__ACTIVE_PATH=/api/v1/runner/active
CLAMS__STRIXPER__RESTART_PATH=/api/v1/runner/restart

# --- direct LLM / inference engine ----------------------------------------
# The OpenAI-compatible engine the watchdog probes at :8731.
# IMPORTANT: inside a container 127.0.0.1 is the container itself, so the
# loopback default can never reach a host-run engine. When Clams detects it is
# containerised it rewrites a loopback base_url to CLAMS__LLM__CONTAINER_BASE_URL.
# Set this explicitly if your engine is not on the host gateway.
CLAMS__LLM__BASE_URL=http://127.0.0.1:8731
CLAMS__LLM__CONTAINER_BASE_URL=http://host.docker.internal:8731

# --- HW-4 safety limits ------------------------------------------------------
CLAMS__LIMITS__MAX_ATTEMPTS=3
CLAMS__LIMITS__MAX_TURNS=40
CLAMS__LIMITS__MAX_WALL_SECONDS=1800
CLAMS__LIMITS__MAX_REPLANS=3
# HW-1 / HW-2 compute ceilings
CLAMS__LIMITS__MAX_COMPUTE_QUEUES=8
CLAMS__LIMITS__MAX_CONCURRENT_ENGINES=2
CLAMS__LIMITS__QUEUES_PER_ENGINE=3

# --- paths -------------------------------------------------------------------
CLAMS__PATHS__DATA_DIR=./data
CLAMS__PATHS__DB_PATH=./data/clams.db
CLAMS__PATHS__WORK_ROOT=./work
CLAMS__PATHS__REPO_PATH=.
CLAMS__PATHS__HEARTBEAT_DIR=./data/heartbeats

# --- watchdog ----------------------------------------------------------------
CLAMS__WATCHDOG__INTERVAL_SECONDS=15
CLAMS__WATCHDOG__HEARTBEAT_MAX_AGE=60
CLAMS__WATCHDOG__DISK_MIN_FREE_BYTES=2147483648
CLAMS__WATCHDOG__QUEUE_MAX_PENDING_AGE=900
CLAMS__WATCHDOG__LLM_PROBE_TIMEOUT=5
CLAMS__WATCHDOG__LLM_FAILURES_CRITICAL=3
CLAMS__WATCHDOG__GITHUB_FAILURES_CRITICAL=3
CLAMS__WATCHDOG__MAX_RECOVERY_ATTEMPTS=3

# --- loop --------------------------------------------------------------------
CLAMS__POLL_INTERVAL=20
